# Copy this file to .env and fill in your own key. Never commit .env.
#   PowerShell:  Copy-Item .env.example .env
#   Git Bash:    cp .env.example .env
# Get a key at https://dev.meta.ai -> API Keys.
MODEL_API_KEY=

# Meta Model API base URL (OpenAI-compatible).
META_BASE_URL=https://api.meta.ai/v1

# live   = call the Meta API (needs MODEL_API_KEY)
# record = call the API and save every response under demo_runs/ for replay
# replay = no key needed; serve recorded responses (keyless demo for judges)
BIKESENSE_MODE=replay
